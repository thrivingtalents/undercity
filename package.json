{
  "name": "undercity",
  "version": "0.1.0",
  "private": true,
  "description": "UNDERCITY — crisis leadership simulation server (HAVEN-9)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "export-content": "node tools/kit/run-python.js tools/export_faults.py tools/undercity-crossref-matrix.xlsx content",
    "create-user": "node scripts/create-user.js",
    "kit": "npm run kit:binders && npm run kit:cards && npm run kit:extras && npm run kit:manifest",
    "kit:content": "node tools/kit/run-python.js tools/kit/assemble_binders.py tools/undercity-crossref-matrix.xlsx build/binder_content.json",
    "kit:binders": "npm run kit:content && node tools/kit/build_binders.js build/binder_content.json kit",
    "kit:cards": "node tools/kit/build_cards.js content/faults.json kit",
    "kit:extras": "node tools/kit/build_kit.js kit && node tools/kit/build_guidebook.js kit",
    "kit:manifest": "node tools/kit/manifest.js kit tools/undercity-crossref-matrix.xlsx content",
    "demo": "node scripts/demo.js",
    "start:lan": "node -e \"process.env.MODE='lan';require('./server.js')\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "docx": "^9.7.1"
  }
}
