  "fault_case_balance_model": {
    "purpose": "Do not balance rewards from phase name alone. Calculate/verify the burden of each fault case using the actual binder repair demands and fault-card severity, then select a random reward whose value fits that fault.",
    "difficulty_formula": "difficultyScore = weightedMaterialBurden + crewBurden + coordinationBurden + severityBonus",
    "weights": {
      "materials": {
        "power_each": 1,
        "water_each": 1,
        "parts_each": 1.25,
        "med_each": 1.5,
        "reason": "Parts and Med are weighted slightly higher because they are less freely replenished in the current game economy than POW/WTR round output."
      },
      "crew": "0.5 points for each required worker above the first.",
      "cross_sector_information": "0.75 points for each external sector/manual/verification dependency.",
      "severity": {
        "1_triangle": 0,
        "2_triangles": 0.5,
        "3_triangles": 1
      }
    },
    "reward_target_formula": "rewardTargetRVU = clamp(ceil(difficultyScore * 0.65), 1, 5)",
    "randomness_rule": "Target RVU controls strength, but the effect is still random. For targets 1–2, use exactly the target RVU. For targets 3–5, allow either target-1 or target RVU, with approximately 70% weight on the full target and 30% on target-1. Never select a reward above the fault's allowed band.",
    "why": "This makes expensive/high-coordination faults more rewarding while ensuring the reward is still smaller than the total burden of the repair in most cases.",
